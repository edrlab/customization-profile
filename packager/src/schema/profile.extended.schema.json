                        "rel": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "enum": [
                                        "preview",
                                        "http://opds-spec.org/acquisition",
                                        "http://opds-spec.org/acquisition/buy",
                                        "http://opds-spec.org/acquisition/open-access",
                                        "http://opds-spec.org/acquisition/borrow",
